//! Array API benchmarks to enable when `linalg::api` is registered.
use criterion::{Criterion, black_box, criterion_group, criterion_main};
use rustnum as np;

fn data(n: usize) -> Vec<f64> {
    (0..n).map(|i| i as f64 / 13.0).collect()
}
fn core(c: &mut Criterion) {
    let million = np::Array::from_vec(data(1_000_000), &[1_000_000]);
    let ten_million = np::Array::from_vec(data(10_000_000), &[10_000_000]);
    let matrix = np::Array::from_vec(data(1_000_000), &[1_000, 1_000]);
    c.bench_function("add_f64_1e6", |b| b.iter(|| black_box(&million + &million)));
    c.bench_function("add_broadcast_1000x1000", |b| {
        b.iter(|| black_box(&matrix + np::Array::from_vec(data(1_000), &[1_000])))
    });
    c.bench_function("sum_f64_1e7", |b| b.iter(|| black_box(ten_million.sum())));
    c.bench_function("mean_axis_0_1000x1000", |b| {
        b.iter(|| black_box(matrix.mean_axis(0)))
    });
    c.bench_function("transpose_contiguous_1000x1000", |b| {
        b.iter(|| black_box(matrix.t().to_contiguous()))
    });
    c.bench_function("exp_f64_1e6", |b| b.iter(|| black_box(million.exp())));
    c.bench_function("sort_f64_1e6", |b| b.iter(|| black_box(million.sort())));
    for n in [256, 512, 1024] {
        let a = np::Array::from_vec(data(n * n), &[n, n]);
        c.bench_function(format!("matmul_f64_{n}"), |b| {
            b.iter(|| black_box(a.matmul(&a)))
        });
    }
    let inv = np::Array::from_vec(data(40_000), &[200, 200]);
    c.bench_function("inv_f64_200", |b| {
        b.iter(|| black_box(np::linalg::inv(&inv)))
    });
    let svd = np::Array::from_vec(data(10_000), &[100, 100]);
    c.bench_function("svd_f64_100", |b| {
        b.iter(|| black_box(np::linalg::svd(&svd)))
    });
}
criterion_group!(benches, core);
criterion_main!(benches);
