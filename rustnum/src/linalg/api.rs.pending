//! Array-facing linalg adapters, intentionally not registered until Phase 1 is merged.
//!
//! This file uses only the documented Array surface.  On merge, move it to
//! `api.rs`, declare it from `mod.rs`, and replace the temporary `NormOrd`
//! import below with the project-wide spelling selected for `norm_axis`.
//!
//! Beyond the original surface this file also wraps the extra kernels documented in
//! `docs/api/linalg-extra.md`: `eig`, `eigvals`, `eigvalsh`, `slogdet`, `cond`, `cond_ord`,
//! `vector_norm`, `matrix_norm`, `multi_dot`, `tensordot`, `tensordot_n`, `vdot` and
//! negative-exponent `matrix_power`.  v0.1 has no complex dtype, so complex results
//! (`eig`, `eigvals`) are returned as separate real and imaginary arrays.

use super::kernels::{self, KernelError, KernelFloat, NormOrd};
use crate::{Array, Error, Float, Num, Result};

fn shape_error(message: impl Into<String>) -> Error {
    Error::Shape(message.into())
}
fn kernel_error(error: KernelError) -> Error {
    match error {
        KernelError::Singular => Error::Singular,
        KernelError::NotPositiveDefinite => Error::NotPositiveDefinite,
        KernelError::NoConvergence => shape_error(
            "Eigenvalues did not converge (the matrix contains NaN or infinity)",
        ),
        KernelError::Shape => shape_error("Last 2 dimensions of the array must be square"),
    }
}
fn matrix_shape<T>(a: &Array<T>) -> Result<(usize, usize)> {
    if a.ndim() != 2 {
        return Err(shape_error("expected a 2-dimensional array"));
    }
    Ok((a.shape()[0], a.shape()[1]))
}
fn square_shape<T>(a: &Array<T>) -> Result<usize> {
    let (rows, cols) = matrix_shape(a)?;
    if rows != cols {
        return Err(shape_error("Last 2 dimensions of the array must be square"));
    }
    Ok(rows)
}

fn batch_offset(shape: &[usize], matrix_dims: usize, batch_shape: &[usize], batch: usize) -> usize {
    let source_batch = &shape[..shape.len() - matrix_dims];
    let mut source_index = 0;
    let mut remaining = batch;
    let mut coordinates = vec![0; batch_shape.len()];
    for axis in (0..batch_shape.len()).rev() {
        coordinates[axis] = remaining % batch_shape[axis];
        remaining /= batch_shape[axis];
    }
    for source_axis in 0..source_batch.len() {
        let output_axis = batch_shape.len() - source_batch.len() + source_axis;
        let coordinate = if source_batch[source_axis] == 1 {
            0
        } else {
            coordinates[output_axis]
        };
        source_index = source_index * source_batch[source_axis] + coordinate;
    }
    source_index * shape[shape.len() - matrix_dims..].iter().product::<usize>()
}

impl<T: Num> Array<T> {
    /// Matrix product, like `np.matmul(a, b)`.
    ///
    /// ```ignore
    /// let product = np::array![[1, 2]].matmul(&np::array![[3], [4]]);
    /// assert_eq!(product.to_vec(), vec![11]);
    /// ```
    pub fn matmul(&self, other: &Array<T>) -> Array<T> {
        assert!(
            self.ndim() > 0 && other.ndim() > 0,
            "matmul: Input operand 0 does not have enough dimensions"
        );
        let left_vector = self.ndim() == 1;
        let right_vector = other.ndim() == 1;
        let (m, k) = if left_vector {
            (1, self.shape()[0])
        } else {
            (self.shape()[self.ndim() - 2], self.shape()[self.ndim() - 1])
        };
        let (other_k, n) = if right_vector {
            (other.shape()[0], 1)
        } else {
            (
                other.shape()[other.ndim() - 2],
                other.shape()[other.ndim() - 1],
            )
        };
        assert_eq!(
            k, other_k,
            "matmul: Input operand 1 has a mismatch in its core dimension 0"
        );
        let left_batch = if left_vector {
            &[][..]
        } else {
            &self.shape()[..self.ndim() - 2]
        };
        let right_batch = if right_vector {
            &[][..]
        } else {
            &other.shape()[..other.ndim() - 2]
        };
        let batch_dims = left_batch.len().max(right_batch.len());
        let mut batch_shape = vec![1; batch_dims];
        for axis in 0..batch_dims {
            let left = if axis + left_batch.len() < batch_dims {
                1
            } else {
                left_batch[axis + left_batch.len() - batch_dims]
            };
            let right = if axis + right_batch.len() < batch_dims {
                1
            } else {
                right_batch[axis + right_batch.len() - batch_dims]
            };
            assert!(
                left == right || left == 1 || right == 1,
                "operands could not be broadcast together"
            );
            batch_shape[axis] = left.max(right);
        }
        let batches = batch_shape.iter().product::<usize>();
        let left_data = self.to_vec();
        let right_data = other.to_vec();
        let mut result = Vec::with_capacity(batches * m * n);
        let left_matrix_dims = if left_vector { 1 } else { 2 };
        let right_matrix_dims = if right_vector { 1 } else { 2 };
        for batch in 0..batches {
            let left_start = batch_offset(self.shape(), left_matrix_dims, &batch_shape, batch);
            let right_start = batch_offset(other.shape(), right_matrix_dims, &batch_shape, batch);
            let block = kernels::gemm(
                m,
                n,
                k,
                &left_data[left_start..],
                if left_vector { k as isize } else { k as isize },
                1,
                &right_data[right_start..],
                if right_vector { 1 } else { n as isize },
                1,
            );
            result.extend(block);
        }
        let mut output_shape = batch_shape;
        if !left_vector {
            output_shape.push(m);
        }
        if !right_vector {
            output_shape.push(n);
        }
        Array::from_vec(result, &output_shape)
    }

    /// Dot product for vectors and matrices, like `np.dot(a, b)`.
    pub fn dot(&self, other: &Array<T>) -> Array<T> {
        assert!(
            self.ndim() <= 2 && other.ndim() <= 2,
            "dot only supports arrays with at most 2 dimensions"
        );
        self.matmul(other)
    }

    /// Sum along the main diagonal, like `np.trace(a)`.
    pub fn trace(&self) -> T {
        assert_eq!(
            self.ndim(),
            2,
            "diag requires an array of at least two dimensions"
        );
        let data = self.to_vec();
        let columns = self.shape()[1];
        (0..self.shape()[0].min(columns)).fold(T::ZERO, |sum, i| sum + data[i * columns + i])
    }
}

/// Linear-algebra functions, like `np.linalg`.
pub mod linalg {
    use super::*;

    /// Outer product of two vectors, like `np.outer(a, b)`.
    pub fn outer<F: Float + KernelFloat>(a: &Array<F>, b: &Array<F>) -> Array<F> {
        let av = a.to_vec();
        let bv = b.to_vec();
        let mut output = Vec::with_capacity(av.len() * bv.len());
        for &left in &av {
            for &right in &bv {
                output.push(left * right);
            }
        }
        Array::from_vec(output, &[av.len(), bv.len()])
    }

    /// Inner product of two vectors, like `np.inner(a, b)`.
    pub fn inner<F: Float + KernelFloat>(a: &Array<F>, b: &Array<F>) -> F {
        assert_eq!(
            a.size(),
            b.size(),
            "shapes are not aligned for inner product"
        );
        a.to_vec()
            .into_iter()
            .zip(b.to_vec())
            .fold(F::ZERO, |sum, (x, y)| sum + x * y)
    }

    /// Determinant of a square matrix, like `np.linalg.det(a)`.
    pub fn det<F: Float + KernelFloat>(a: &Array<F>) -> F {
        let n = square_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::Lu::factor(&a.to_vec(), n)
            .map(|factor| factor.det())
            .unwrap_or(F::ZERO)
    }

    /// Inverse of a nonsingular square matrix, like `np.linalg.inv(a)`.
    pub fn inv<F: Float + KernelFloat>(a: &Array<F>) -> Result<Array<F>> {
        let n = square_shape(a)?;
        kernels::inv(&a.to_vec(), n)
            .map(|data| Array::from_vec(data, &[n, n]))
            .map_err(kernel_error)
    }

    /// Solution of `a @ x = b`, like `np.linalg.solve(a, b)`.
    pub fn solve<F: Float + KernelFloat>(a: &Array<F>, b: &Array<F>) -> Result<Array<F>> {
        let n = square_shape(a)?;
        assert!(
            b.ndim() == 1 || b.ndim() == 2,
            "solve: Input operand 1 must have one or two dimensions"
        );
        let rhs_cols = if b.ndim() == 1 { 1 } else { b.shape()[1] };
        if b.shape()[0] != n {
            return Err(shape_error(
                "solve: Input operand 1 has a mismatch in its core dimension 0",
            ));
        }
        kernels::Lu::factor(&a.to_vec(), n)
            .and_then(|factor| factor.solve(&b.to_vec(), rhs_cols))
            .map(|data| {
                Array::from_vec(
                    data,
                    if b.ndim() == 1 {
                        &[n][..]
                    } else {
                        &[n, rhs_cols][..]
                    },
                )
            })
            .map_err(kernel_error)
    }

    /// Least-squares solution, like `np.linalg.lstsq(a, b)`.
    pub fn lstsq<F: Float + KernelFloat>(a: &Array<F>, b: &Array<F>) -> Result<Array<F>> {
        let (rows, cols) = matrix_shape(a)?;
        let rhs_cols = if b.ndim() == 1 {
            1
        } else if b.ndim() == 2 {
            b.shape()[1]
        } else {
            return Err(shape_error("expected a vector or matrix right-hand side"));
        };
        if b.shape()[0] != rows {
            return Err(shape_error("Incompatible dimensions"));
        }
        kernels::lstsq(&a.to_vec(), rows, cols, &b.to_vec(), rhs_cols)
            .map(|data| {
                Array::from_vec(
                    data,
                    if b.ndim() == 1 {
                        &[cols][..]
                    } else {
                        &[cols, rhs_cols][..]
                    },
                )
            })
            .map_err(kernel_error)
    }

    /// Moore-Penrose pseudoinverse, like `np.linalg.pinv(a)`.
    pub fn pinv<F: Float + KernelFloat>(a: &Array<F>) -> Array<F> {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        Array::from_vec(
            kernels::pinv(&a.to_vec(), rows, cols).unwrap_or_else(|e| panic!("{}", kernel_error(e))),
            &[cols, rows],
        )
    }

    /// Frobenius or Euclidean norm, like `np.linalg.norm(a)`.
    pub fn norm<F: Float + KernelFloat>(a: &Array<F>) -> F {
        kernels::norm(&a.to_vec())
    }

    /// Per-axis norm, like `np.linalg.norm(a, ord=..., axis=...)`.
    pub fn norm_axis<F: Float + KernelFloat>(a: &Array<F>, ord: NormOrd, axis: isize) -> Array<F> {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        let axis = if axis < 0 {
            (2 + axis) as usize
        } else {
            axis as usize
        };
        Array::from_vec(
            kernels::norm_axis(&a.to_vec(), rows, cols, axis, ord)
                .unwrap_or_else(|_| panic!("Invalid norm order for vectors or axis out of range")),
            &[if axis == 0 { cols } else { rows }],
        )
    }

    /// Lower Cholesky factor, like `np.linalg.cholesky(a)`.
    pub fn cholesky<F: Float + KernelFloat>(a: &Array<F>) -> Result<Array<F>> {
        let n = square_shape(a)?;
        kernels::cholesky(&a.to_vec(), n)
            .map(|data| Array::from_vec(data, &[n, n]))
            .map_err(kernel_error)
    }

    /// Reduced QR factorisation, like `np.linalg.qr(a, mode="reduced")`.
    pub fn qr<F: Float + KernelFloat>(a: &Array<F>) -> (Array<F>, Array<F>) {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        let (q, r, reduced) = kernels::qr(&a.to_vec(), rows, cols).expect("valid matrix shape");
        (
            Array::from_vec(q, &[rows, reduced]),
            Array::from_vec(r, &[reduced, cols]),
        )
    }

    /// Symmetric eigendecomposition, like `np.linalg.eigh(a)`.
    pub fn eigh<F: Float + KernelFloat>(a: &Array<F>) -> (Array<F>, Array<F>) {
        let n = square_shape(a).unwrap_or_else(|error| panic!("{error}"));
        let (values, vectors) =
            kernels::eigh(&a.to_vec(), n).unwrap_or_else(|e| panic!("{}", kernel_error(e)));
        (
            Array::from_vec(values, &[n]),
            Array::from_vec(vectors, &[n, n]),
        )
    }

    /// Reduced singular-value decomposition, like `np.linalg.svd(a, full_matrices=False)`.
    pub fn svd<F: Float + KernelFloat>(a: &Array<F>) -> (Array<F>, Array<F>, Array<F>) {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        let (u, values, vt, reduced) =
            kernels::svd(&a.to_vec(), rows, cols).unwrap_or_else(|e| panic!("{}", kernel_error(e)));
        (
            Array::from_vec(u, &[rows, reduced]),
            Array::from_vec(values, &[reduced]),
            Array::from_vec(vt, &[reduced, cols]),
        )
    }

    /// Numerical matrix rank, like `np.linalg.matrix_rank(a)`.
    pub fn matrix_rank<F: Float + KernelFloat>(a: &Array<F>) -> usize {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::matrix_rank(&a.to_vec(), rows, cols).unwrap_or_else(|e| panic!("{}", kernel_error(e)))
    }

    /// Integer matrix power, like `np.linalg.matrix_power(a, n)`.
    ///
    /// `n == 0` gives the identity; a negative `n` inverts `a` first and returns
    /// `Err(Error::Singular)` when `a` has no inverse.
    ///
    /// ```ignore
    /// let fib = np::array![[1.0, 1.0], [1.0, 0.0]];
    /// assert_eq!(np::linalg::matrix_power(&fib, 10).unwrap().to_vec(), vec![89.0, 55.0, 55.0, 34.0]);
    /// ```
    pub fn matrix_power<F: Float + KernelFloat>(a: &Array<F>, n: i32) -> Result<Array<F>> {
        let size = square_shape(a)?;
        kernels::matrix_power(&a.to_vec(), size, i64::from(n))
            .map(|data| Array::from_vec(data, &[size, size]))
            .map_err(kernel_error)
    }

    /// Eigenvalues and right eigenvectors of a general square matrix, like `np.linalg.eig(a)`.
    ///
    /// Returns `(w_re, w_im, v_re, v_im)`: the eigenvalues `w_re + i w_im` (shape `[n]`) and the
    /// eigenvectors `v_re + i v_im` as the columns of two `[n, n]` arrays.  Real eigenvalues have
    /// `w_im == 0`; complex conjugate pairs are adjacent, positive imaginary part first.  Every
    /// eigenvector has unit 2-norm and its largest component is real and positive.  Eigenvalue
    /// order follows the Schur form and may differ from NumPy's.
    ///
    /// ```ignore
    /// let rotation = np::array![[0.0, -1.0], [1.0, 0.0]];
    /// let (re, im, _, _) = np::linalg::eig(&rotation).unwrap();
    /// assert_eq!((re.to_vec(), im.to_vec()), (vec![0.0, 0.0], vec![1.0, -1.0]));
    /// ```
    pub fn eig<F: Float + KernelFloat>(a: &Array<F>) -> Result<(Array<F>, Array<F>, Array<F>, Array<F>)> {
        let n = square_shape(a)?;
        kernels::eig(&a.to_vec(), n)
            .map(|(w_re, w_im, v_re, v_im)| {
                (
                    Array::from_vec(w_re, &[n]),
                    Array::from_vec(w_im, &[n]),
                    Array::from_vec(v_re, &[n, n]),
                    Array::from_vec(v_im, &[n, n]),
                )
            })
            .map_err(kernel_error)
    }

    /// Eigenvalues of a general square matrix as `(re, im)`, like `np.linalg.eigvals(a)`.
    ///
    /// ```ignore
    /// let (re, im) = np::linalg::eigvals(&np::array![[2.0, 0.0], [0.0, 3.0]]).unwrap();
    /// assert_eq!((re.to_vec(), im.to_vec()), (vec![2.0, 3.0], vec![0.0, 0.0]));
    /// ```
    pub fn eigvals<F: Float + KernelFloat>(a: &Array<F>) -> Result<(Array<F>, Array<F>)> {
        let n = square_shape(a)?;
        kernels::eigvals(&a.to_vec(), n)
            .map(|(re, im)| (Array::from_vec(re, &[n]), Array::from_vec(im, &[n])))
            .map_err(kernel_error)
    }

    /// Ascending eigenvalues of a symmetric matrix, like `np.linalg.eigvalsh(a)`.
    ///
    /// ```ignore
    /// let w = np::linalg::eigvalsh(&np::array![[2.0, 1.0], [1.0, 2.0]]);
    /// assert!((w.to_vec()[0] - 1.0).abs() < 1e-12 && (w.to_vec()[1] - 3.0).abs() < 1e-12);
    /// ```
    pub fn eigvalsh<F: Float + KernelFloat>(a: &Array<F>) -> Array<F> {
        let n = square_shape(a).unwrap_or_else(|error| panic!("{error}"));
        Array::from_vec(
            kernels::eigvalsh(&a.to_vec(), n).unwrap_or_else(|e| panic!("{}", kernel_error(e))),
            &[n],
        )
    }

    /// Sign and natural log of the absolute determinant, like `np.linalg.slogdet(a)`.
    ///
    /// A singular matrix gives `(0, -inf)`.
    ///
    /// ```ignore
    /// let (sign, logabsdet) = np::linalg::slogdet(&np::array![[1.0, 2.0], [3.0, 4.0]]);
    /// assert_eq!(sign, -1.0);
    /// assert!((logabsdet - 2.0_f64.ln()).abs() < 1e-12);
    /// ```
    pub fn slogdet<F: Float + KernelFloat>(a: &Array<F>) -> (F, F) {
        let n = square_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::slogdet(&a.to_vec(), n).unwrap_or_else(|e| panic!("{}", kernel_error(e)))
    }

    /// 2-norm condition number `s_max / s_min`, like `np.linalg.cond(a)`.
    ///
    /// ```ignore
    /// assert!((np::linalg::cond(&np::eye::<f64>(3)) - 1.0).abs() < 1e-12);
    /// ```
    pub fn cond<F: Float + KernelFloat>(a: &Array<F>) -> F {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::cond(&a.to_vec(), rows, cols).unwrap_or_else(|e| panic!("{}", kernel_error(e)))
    }

    /// Condition number in another norm, like `np.linalg.cond(a, p)` for `p` in
    /// `{fro, 1, 2, inf, -1, -2, -inf, nuc}`; `inf` for a singular matrix.
    ///
    /// ```ignore
    /// let a = np::array![[1.0, 2.0], [3.0, 4.0]];
    /// let c = np::linalg::cond_ord(&a, NormOrd::One);
    /// assert!((c - 21.0).abs() < 1e-10);
    /// ```
    pub fn cond_ord<F: Float + KernelFloat>(a: &Array<F>, ord: NormOrd) -> F {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::cond_ord(&a.to_vec(), rows, cols, ord)
            .unwrap_or_else(|_| panic!("Invalid norm order for matrices"))
    }

    /// Vector norm of any order except `nuc`, like `np.linalg.vector_norm(x, ord=ord)`.
    ///
    /// The input is flattened first, as in NumPy.
    ///
    /// ```ignore
    /// let x = np::array![3.0, -4.0];
    /// assert_eq!(np::linalg::vector_norm(&x, NormOrd::Two), 5.0);
    /// assert_eq!(np::linalg::vector_norm(&x, NormOrd::Inf), 4.0);
    /// ```
    pub fn vector_norm<F: Float + KernelFloat>(a: &Array<F>, ord: NormOrd) -> F {
        kernels::vector_norm(&a.to_vec(), ord)
            .unwrap_or_else(|_| panic!("Invalid norm order for vectors"))
    }

    /// Matrix norm of any order except `0`, like `np.linalg.matrix_norm(a, ord=ord)`.
    ///
    /// ```ignore
    /// let a = np::array![[1.0, -2.0], [3.0, -4.0]];
    /// assert_eq!(np::linalg::matrix_norm(&a, NormOrd::One), 6.0);
    /// assert_eq!(np::linalg::matrix_norm(&a, NormOrd::Inf), 7.0);
    /// ```
    pub fn matrix_norm<F: Float + KernelFloat>(a: &Array<F>, ord: NormOrd) -> F {
        let (rows, cols) = matrix_shape(a).unwrap_or_else(|error| panic!("{error}"));
        kernels::matrix_norm(&a.to_vec(), rows, cols, ord)
            .unwrap_or_else(|_| panic!("Invalid norm order for matrices"))
    }

    /// Product of several matrices with the cheapest parenthesisation, like `np.linalg.multi_dot`.
    ///
    /// The first and last arrays may be 1-d (treated as a row / column vector and squeezed from
    /// the result); all others must be 2-d.  Panics with fewer than two arrays or misaligned shapes.
    ///
    /// ```ignore
    /// let a = np::array![[1, 2], [3, 4]];
    /// let b = np::array![[0, 1], [1, 0]];
    /// let c = np::array![[2, 0], [0, 2]];
    /// assert_eq!(np::linalg::multi_dot(&[&a, &b, &c]).to_vec(), vec![4, 2, 8, 6]);
    /// ```
    pub fn multi_dot<T: Num>(arrays: &[&Array<T>]) -> Array<T> {
        assert!(arrays.len() >= 2, "Expecting at least two arrays.");
        let last = arrays.len() - 1;
        let buffers: Vec<Vec<T>> = arrays.iter().map(|array| array.to_vec()).collect();
        let mut dims = Vec::with_capacity(arrays.len());
        for (index, array) in arrays.iter().enumerate() {
            dims.push(match array.ndim() {
                1 if index == 0 => (1, array.shape()[0]),
                1 if index == last => (array.shape()[0], 1),
                2 => (array.shape()[0], array.shape()[1]),
                _ => panic!("multi_dot: the first and last arguments may be 1-D, all others must be 2-D"),
            });
        }
        let chain: Vec<(&[T], usize, usize)> = buffers
            .iter()
            .zip(&dims)
            .map(|(buffer, &(rows, cols))| (buffer.as_slice(), rows, cols))
            .collect();
        let (data, rows, cols) = kernels::multi_dot(&chain)
            .unwrap_or_else(|_| panic!("multi_dot: shapes are not aligned"));
        let mut shape = Vec::new();
        if arrays[0].ndim() == 2 {
            shape.push(rows);
        }
        if arrays[last].ndim() == 2 {
            shape.push(cols);
        }
        Array::from_vec(data, &shape)
    }

    fn normalize_axes(axes: &[isize], ndim: usize) -> Vec<usize> {
        axes.iter()
            .map(|&axis| {
                let size = ndim as isize;
                assert!(
                    (-size..size).contains(&axis),
                    "tensordot: axis {axis} is out of bounds for array of dimension {ndim}"
                );
                (if axis < 0 { axis + size } else { axis }) as usize
            })
            .collect()
    }

    /// Tensor contraction over paired axes, like `np.tensordot(a, b, axes=(axes_a, axes_b))`.
    ///
    /// The result shape is the free axes of `a` followed by the free axes of `b`; contracting
    /// every axis gives a 0-d array.  Panics with `shape-mismatch for sum` when the paired axes
    /// differ in length, repeat, or have different sizes.
    ///
    /// ```ignore
    /// let a = np::array![[1, 2], [3, 4]];
    /// let product = np::linalg::tensordot(&a, &a, &[1], &[0]);
    /// assert_eq!(product.to_vec(), vec![7, 10, 15, 22]);
    /// ```
    pub fn tensordot<T: Num>(a: &Array<T>, b: &Array<T>, axes_a: &[isize], axes_b: &[isize]) -> Array<T> {
        let (data, shape) = kernels::tensordot(
            &a.to_vec(),
            a.shape(),
            &b.to_vec(),
            b.shape(),
            &normalize_axes(axes_a, a.ndim()),
            &normalize_axes(axes_b, b.ndim()),
        )
        .unwrap_or_else(|_| panic!("shape-mismatch for sum"));
        Array::from_vec(data, &shape)
    }

    /// `np.tensordot(a, b, axes=n)`: contract the last `n` axes of `a` with the first `n` of `b`.
    ///
    /// Not a separate NumPy function; it is the integer form of NumPy's `axes` argument.
    ///
    /// ```ignore
    /// let a = np::array![[1, 2], [3, 4]];
    /// assert_eq!(np::linalg::tensordot_n(&a, &a, 2).item(), 30);
    /// ```
    pub fn tensordot_n<T: Num>(a: &Array<T>, b: &Array<T>, n: usize) -> Array<T> {
        assert!(
            n <= a.ndim() && n <= b.ndim(),
            "tensordot: cannot contract {n} axes of arrays with {} and {} dimensions",
            a.ndim(),
            b.ndim()
        );
        let axes_a: Vec<isize> = (a.ndim() - n..a.ndim()).map(|axis| axis as isize).collect();
        let axes_b: Vec<isize> = (0..n).map(|axis| axis as isize).collect();
        tensordot(a, b, &axes_a, &axes_b)
    }

    /// Dot product of the flattened arrays, like `np.vdot(a, b)` (no conjugation: real data only).
    ///
    /// ```ignore
    /// let a = np::array![[1, 2], [3, 4]];
    /// assert_eq!(np::linalg::vdot(&a, &a), 30);
    /// ```
    pub fn vdot<T: Num>(a: &Array<T>, b: &Array<T>) -> T {
        kernels::vdot(&a.to_vec(), &b.to_vec())
            .unwrap_or_else(|_| panic!("vectors have different lengths"))
    }
}
